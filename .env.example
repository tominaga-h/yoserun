# Supabase の Postgres 接続文字列（Project Settings → Database → Connection string → Transaction pooler）
# 未設定ならローカルの .data/yoserun.json に保存される
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# （任意）共有URLの起点。未設定ならリクエストのホストから作る
# SITE_URL=https://yoserun.example.com
